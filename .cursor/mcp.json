{
  "mcpServers": {
    "expo": {
      "url": "https://mcp.expo.dev/mcp"
    },
    "supabase": {
      "url": "https://mcp.supabase.com/mcp?project_ref=flbdllwugemxjjpcawku&features=database,debugging,development,docs"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  }
}
